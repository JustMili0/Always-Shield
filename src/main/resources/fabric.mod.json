  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://modrinth.com/mod/always-shield",
    "sources": "https://github.com/Lumynity-Studios/Always-Shield",
    "issues": "https://github.com/Lumynity-Studios/Always-Shield/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.justmili.alwaysshield.AlwaysShield"
    ]
